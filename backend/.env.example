# =============================================================================
# Backend Environment Variables - BWMS
# نسخ هذا الملف إلى .env وتعبئة القيم الحقيقية
# =============================================================================

# Server
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bwms
DB_USER=root
DB_PASSWORD=

# JWT Secrets - أنشئ بـ: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary (مجاني - للملفات)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=نظام بصمة
EMAIL_FROM_ADDRESS=

# Frontend URL (للـ CORS وروابط البريد)
FRONTEND_URL=http://localhost:5173

# Timezone
TZ=Asia/Aden

# Logging
LOG_LEVEL=debug
